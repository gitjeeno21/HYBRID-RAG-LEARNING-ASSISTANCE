# Copy this file to .env and fill in your own key. Never commit .env.
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Email for verification and password-reset codes, sent server-side via EmailJS
# (https://www.emailjs.com). Leave empty to print codes in the server terminal
# instead (local development only). See HOW_TO_RUN.md, "Email setup".
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
